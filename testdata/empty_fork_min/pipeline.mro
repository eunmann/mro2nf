# A map call over an INVOCATION-known empty collection ([] baked through the
# launch call): Martian's static resolver prunes the zero-fork call, so the
# output resolves to NULL. The run's plan compiles the invocation as mrp does,
# keeping entry inputs overridable at launch (#99): override `values` to a
# non-empty list and the forks run (expected/override_outs.json pins that); a
# stage-produced empty/null source merges to the typed empty instead
# (runtime_empty_forks).
stage SCALE(
    in  float value,
    in  float factor,
    out float scaled,
    src py    "stages/scale",
)

pipeline EF(
    in  float[] values,
    in  float   factor,
    out float[] scaled,
)
{
    map call SCALE(
        value  = split self.values,
        factor = self.factor,
    )

    return (
        scaled = SCALE.scaled,
    )
}

call EF(
    values = [],
    factor = 10.0,
)
