# A map call over an INVOCATION-known empty collection ([] baked through the
# launch call): Martian's static resolver merges the zero-fork call to the
# typed empty [], as a stage-produced empty source merges at run time
# (runtime_empty_forks); Martian before 50ad6c0 merged it to null. The run's
# plan compiles the invocation as mrp does, keeping entry inputs overridable
# at launch (#99): override `values` to a non-empty list and the forks run
# (expected/override_outs.json pins that).
stage SCALE(
    in  float value,
    in  float factor,
    out float scaled,
    src py    "stages/scale",
)

pipeline EF(
    in  float[] values,
    in  float   factor,
    out float[] scaled,
)
{
    map call SCALE(
        value  = split self.values,
        factor = self.factor,
    )

    return (
        scaled = SCALE.scaled,
    )
}

call EF(
    values = [],
    factor = 10.0,
)
