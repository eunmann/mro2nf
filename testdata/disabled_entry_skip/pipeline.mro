# The entry bakes skip=true, so GEN's disabled=self.skip gate skips it at run
# time. USE is a downstream stage that consumes GEN's null output. KEEP always
# runs.
stage GEN(
    out int y,
    src py "stages/gen",
)

stage USE(
    in  int y,
    out int w,
    src py "stages/use",
)

stage KEEP(
    out int z,
    src py "stages/keep",
)

pipeline P(
    in  bool skip,
    out int  y,
    out int  z,
    out int  w,
)
{
    call GEN() using (
        disabled = self.skip,
    )

    call USE(
        y = GEN.y,
    )

    call KEEP()

    return (
        y = GEN.y,
        z = KEEP.z,
        w = USE.w,
    )
}

call P(
    skip = true,
)
