# Failure-path fixture (#274): UP returns a struct output missing a declared
# member. mrp fails UP at its own output validation ("Expected S output value
# 's' missing key: b") before DOWN, which projects UP.s.b, can run; mro2nf must
# fail the same stage rather than bind the projection as null. Exercised by
# TestInvalidOutputFailsLikeMrp and TestMrpDiffFailureParity (a failed run has
# no golden).
struct S(
    int a,
    int b,
)

stage UP(
    out S s,
    src py "stages/up",
)

stage DOWN(
    in  int    b,
    out string t,
    src py     "stages/down",
)

pipeline P(
    out string t,
)
{
    call UP()

    call DOWN(
        b = UP.s.b,
    )

    return (
        t = DOWN.t,
    )
}

call P()
