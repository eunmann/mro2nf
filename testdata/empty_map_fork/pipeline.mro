# A map call over an INVOCATION-known empty typed-map source ({} baked through
# the entry call): Martian's static resolver merges the zero-fork call to the
# typed empty {}, as a RUNTIME empty collection merges (runtime_empty_forks
# covers that side); Martian before 50ad6c0 merged it to null. The run's plan
# compiles the invocation as mrp does, so the entry input stays
# launch-overridable (#99).
stage DBL(
    in  int v,
    out int w,
    src py  "stages/dbl",
)

pipeline EMP(
    in  map<int> m,
    out map<int> w,
)
{
    map call DBL(
        v = split self.m,
    )

    return (
        w = DBL.w,
    )
}

call EMP(
    m = {},
)
