# Failure-path fixture: the stage raises a Martian assertion (martian.exit).
# The run must TERMINATE without a retry — the shim exits 42 and the generated
# errorStrategy maps 42 to 'terminate'. Exercised by
# TestAssertTerminatesWithoutRetry, and against mrp's own assert by
# TestMrpDiffFailureParity (a failed run has no golden).
stage BOOM(
    in  float x,
    out float y,
    src py    "stages/boom",
)

pipeline AP(
    in  float x,
    out float y,
)
{
    call BOOM(
        x = self.x,
    )

    return (
        y = BOOM.y,
    )
}

call AP(
    x = 1.0,
)
