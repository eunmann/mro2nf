# A top-level `map call` forks the entry pipeline per collection element,
# and its outs are the pipeline's outs per fork. testdata/map_call_entry runs
# this shape under both runners.

stage DOUBLE(
    in  int x,
    out int y,
    src py  "stages/double",
)

pipeline DOUBLER(
    in  int x,
    out int y,
)
{
    call DOUBLE(
        x = self.x,
    )

    return (
        y = DOUBLE.y,
    )
}

map call DOUBLER(
    x = split [
        1,
        2,
        3,
    ],
)
