# #387: mrp refuses this pipeline before any stage runs. A map call over a
# non-empty literal under a runtime disable gate resolves to a gated array of
# fork outputs, and B's split of it fails mrp's binding type walk with
# "RTG.B input value: unexpected array". mro2nf refuses it at transpile time.
stage GATE(
    in  bool v,
    out bool off,
    src py   "stages/gate",
)

stage SCALE(
    in  int value,
    out int scaled,
    src py  "stages/scale",
)

pipeline RTG(
    in  int[] some,
    in  bool  skip,
    out int[] b,
)
{
    call GATE(
        v = self.skip,
    )

    map call SCALE as A(
        value = split self.some,
    ) using (
        disabled = GATE.off,
    )

    map call SCALE as B(
        value = split A.scaled,
    )

    return (
        b = B.scaled,
    )
}

call RTG(
    some = [1, 2],
    skip = false,
)
