# A map call whose SPLIT source is an UPSTREAM stage output (value = split
# GEN.values), not a pipeline input: GEN's post writes one fork element per
# value, and each fork instance stages only its own (#99).
stage GEN(
    in  int     n,
    out float[] values,
    src py      "stages/gen",
)

stage SCALE(
    in  float value,
    in  float factor,
    out float scaled,
    src py    "stages/scale",
)

pipeline SCALE_UP(
    in  int   n,
    in  float factor,
    out float[] scaled,
)
{
    call GEN(
        n = self.n,
    )

    map call SCALE(
        value  = split GEN.values,
        factor = self.factor,
    )

    return (
        scaled = SCALE.scaled,
    )
}

call SCALE_UP(
    n      = 3,
    factor = 10.0,
)
