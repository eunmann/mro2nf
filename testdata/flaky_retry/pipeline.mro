# Failure-path fixture, run with -monitor: the stage requests 0.5 GB but holds
# about 0.75 GB resident, so attempt 1's RSS kill (at mrp's 0.5 GB) fails it
# (ordinary, retryable). The retry is allocated 2 GB (`memory { 1 *
# task.attempt GB }`), the kill limit follows that allocation, and the stage
# succeeds while still seeing mrp's 0.5 GB request. A successful run reporting
# 0.5 therefore proves the retry, the escalated monitor limit, and that the
# escalation never reaches the stage (#243).
stage FLAKY(
    in  float x,
    out float mem_gb,
    out float arg_mem_gb,
    src py    "stages/flaky",
) using (
    mem_gb = 0.5,
)

pipeline FR(
    in  float x,
    out float mem_gb,
    out float arg_mem_gb,
)
{
    call FLAKY(
        x = self.x,
    )

    return (
        mem_gb     = FLAKY.mem_gb,
        arg_mem_gb = FLAKY.arg_mem_gb,
    )
}

call FR(
    x = 1.0,
)
