# Failure-path fixture: the stage requests 0.5 GB but holds about 0.75 GB
# resident. Under --mro2nf_monitor true, as under mrp --monitor, the kill at
# its 0.5 GB request fails the run, which mrp does not retry without
# --auto-adjust-memory (TestMonitorMemoryKillFailsLikeMrp). Without monitor
# neither mrp nor mro2nf enforces the request, so TestMrpDiff diffs the plain
# run, in which the stage sees its 0.5 GB request.
stage FLAKY(
    in  float x,
    out float mem_gb,
    out float arg_mem_gb,
    src py    "stages/flaky",
) using (
    mem_gb = 0.5,
)

pipeline FR(
    in  float x,
    out float mem_gb,
    out float arg_mem_gb,
)
{
    call FLAKY(
        x = self.x,
    )

    return (
        mem_gb     = FLAKY.mem_gb,
        arg_mem_gb = FLAKY.arg_mem_gb,
    )
}

call FR(
    x = 1.0,
)
