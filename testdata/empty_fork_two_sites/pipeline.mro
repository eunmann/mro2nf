# #241: one sub-pipeline instantiated at two call sites whose split sources
# differ in kind. mrp's static resolver merges S1's zero-fork map call (an
# invocation-known empty, chained from the entry), while S2's runtime-empty
# collection (a GEN output) merges at run time. Both give the typed empty []
# since Martian 50ad6c0; before it S1's gave null, so the empty-fork rule was
# decided per call site.
stage GEN(
    out int[] arr_empty,
    src py    "stages/gen",
)

stage SCALE(
    in  int value,
    out int scaled,
    src py  "stages/scale",
)

pipeline SUB(
    in  int[] xs,
    out int[] ys,
)
{
    map call SCALE(
        value = split self.xs,
    )

    return (
        ys = SCALE.scaled,
    )
}

pipeline TOP(
    in  int[] empty,
    in  bool  off,
    out int[] a,
    out int[] b,
)
{
    call GEN(
    )

    call SUB as S1(
        xs = self.empty,
    ) using (
        disabled = self.off,
    )

    call SUB as S2(
        xs = GEN.arr_empty,
    ) using (
        disabled = self.off,
    )

    return (
        a = S1.ys,
        b = S2.ys,
    )
}

call TOP(
    empty = [],
    off   = false,
)
