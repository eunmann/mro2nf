# SRC feeds USE and also gates GATE via disabled = SRC.flag, so one producer
# has a binding consumer and a disable-gate consumer.
stage SRC(
    in  int  x,
    out int  y,
    out bool flag,
    src py    "stages/src",
)

stage USE(
    in  int y,
    in  int k,
    out int z,
    src py    "stages/use",
)

stage GATE(
    out int w,
    src py    "stages/gate",
)

pipeline CH(
    in  int x,
    in  int k,
    out int z,
    out int w,
)
{
    call SRC(
        x = self.x,
    )

    call USE(
        y = SRC.y,
        k = self.k,
    )

    call GATE() using (
        disabled = SRC.flag,
    )

    return (
        z = USE.z,
        w = GATE.w,
    )
}

call CH(
    x = 4,
    k = 3,
)
