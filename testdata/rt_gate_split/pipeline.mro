# #387, #595: B splits the outs of map call A, which a runtime gate
# disables. A maps over a literal of known length, so B has A's forks
# whatever the gate, each reading its fork of A's outs through the gate
# (`[A.scaled, A.scaled] unless GATE.off`). Martian refused this before
# 50ad6c0 ("RTG.B input value: unexpected array"); rt_gate_split_on runs it
# with the gate on.
stage GATE(
    in  bool v,
    out bool off,
    src py   "stages/gate",
)

stage SCALE(
    in  int value,
    out int scaled,
    src py  "stages/scale",
)

pipeline RTG(
    in  int[] some,
    in  bool  skip,
    out int[] b,
)
{
    call GATE(
        v = self.skip,
    )

    map call SCALE as A(
        value = split self.some,
    ) using (
        disabled = GATE.off,
    )

    map call SCALE as B(
        value = split A.scaled,
    )

    return (
        b = B.scaled,
    )
}

call RTG(
    some = [1, 2],
    skip = false,
)
