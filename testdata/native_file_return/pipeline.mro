# A single pipeline whose return combines two calls and one of whose returned
# outputs is a FILE: the published file must match mrp's byte for byte (#76).
filetype txt;

stage MAKE_NOTE(
    in  int  x,
    out txt  note,
    src py   "stages/note",
)

stage DOUBLE(
    in  int  x,
    out int  y,
    src py   "stages/double",
)

pipeline NF(
    in  int  x,
    out txt  note,
    out int  y,
)
{
    call MAKE_NOTE(
        x = self.x,
    )

    call DOUBLE(
        x = self.x,
    )

    return (
        note = MAKE_NOTE.note,
        y    = DOUBLE.y,
    )
}

call NF(
    x = 21,
)
