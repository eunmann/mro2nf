filetype txt;

# #520, #543: a stage that opens a companion file beside its entry file
# input, as a tool opens an index beside a BAM. mrp passes the invocation's
# path, so the companion is found; so does mro2nf, whose tasks read a
# head-node path in place. Exercised by TestMrpDiff. The input is /dev/null
# and the companion /dev/zero: mrp passes an invocation path verbatim, so a
# relative one would not resolve in its job dir, and /dev holds both on every
# host.
stage READ_WITH_INDEX(
    in  txt    reads,
    in  string companion,
    out int    index_bytes,
    src py     "stages/read_with_index",
)

pipeline EFS(
    in  txt    reads,
    out int    index_bytes,
)
{
    call READ_WITH_INDEX(
        reads     = self.reads,
        companion = "zero",
    )

    return (
        index_bytes = READ_WITH_INDEX.index_bytes,
    )
}

call EFS(
    reads = "/dev/null",
)
