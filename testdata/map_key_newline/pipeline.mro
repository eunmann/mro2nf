# #341: a map call over a map whose key holds a newline, the callee emitting a
# file. mrp publishes each fork's file at outs/fs/<key>.txt, the newline
# included, and the outs JSON names it there.
filetype txt;

stage WRITEF(
    in  int i,
    out txt f,
    src py  "stages/writef",
)

pipeline MKN(
    in  map<int> m,
    out map<txt> fs,
)
{
    map call WRITEF(
        i = split self.m,
    )

    return (
        fs = WRITEF.f,
    )
}

call MKN(
    m = {
        "a\nb": 1,
        "c":    2,
    },
)
