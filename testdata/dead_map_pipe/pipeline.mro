# Regression fixture for #59: DEAD is a declared-but-never-called pipeline that
# contains a `map call`, while the entry (MAIN) reaches GEN only through a
# PLAIN call. The project runs MAIN's nodes alone and lints clean.
filetype txt;

stage GEN(
    in  float x,
    out float y,
    src py    "stages/gen",
)

pipeline DEAD(
    in  float[] xs,
    out float[] ys,
)
{
    map call GEN(
        x = split self.xs,
    )
    return (
        ys = GEN.y,
    )
}

pipeline MAIN(
    in  float x,
    out float y,
)
{
    call GEN(
        x = self.x,
    )
    return (
        y = GEN.y,
    )
}

call MAIN(
    x = 1.0,
)
