# #127 value-chain divergence (c): a MIXED split — an entry-ref binding zipped
# with an upstream stage ref, where the entry side resolves empty. mrp's
# static resolver knows the entry side's length (0) and merges the zero-fork
# call statically, even though the upstream side is runtime-produced: to []
# since Martian 50ad6c0, to null before it.
stage GEN(
    out int[] more,
    src py    "stages/gen",
)

stage PAIR(
    in  int a,
    in  int b,
    out int s,
    src py  "stages/pair",
)

pipeline EFM(
    in  int[] lhs,
    out int[] sums,
)
{
    call GEN(
    )

    map call PAIR(
        a = split self.lhs,
        b = split GEN.more,
    )

    return (
        sums = PAIR.s,
    )
}

call EFM(
    lhs = [],
)
